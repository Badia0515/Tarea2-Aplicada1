@page "/weather"
@page "/Edicion"
@using Tarea2.Models
@using Tarea2.Service
@inject EstudianteService estudinateService;
@rendermode InteractiveServer

<PageTitle>Modo Edicion</PageTitle>

<div class="container">
    <div class=" card border-4"style="width:400px; margin:auto; height:240px">
        <div class="text-center">
            <h5>Modo Edicion</h5>
            <label>Nombre</label>
            <input class="text"@bind="estudianteEdicion.Nombre" />
            <br />
            <label>Dirrecion</label>
            <input class="text"@bind="estudianteEdicion.Dirrecion" />
            <br />
            <label>Email</label>
            <input class="text" @bind="estudianteEdicion.Email" />
            <br />
            <label>Fecha de Nacimiento</label>
            <input class="text" @bind="estudianteEdicion.FechaNacimiento" />
            <br />
            <br />
            <button class="btn btn-warning">Consultar</button> 
                    <button class="btn btn-primary">Guardar</button>         
     

            

        </div>
       

    </div>
    
</div>


@code {
    Estudiantes estudianteEdicion { get; set; } = new();
    public List<Estudiantes> Estudiantes { get; set; } = [];


    public async Task Edicion(int id)
    {
        var Estudiante = await estudinateService.Buscar(id);
        if (Estudiante != null)
        {
            estudianteEdicion = Estudiante;
        }
    }

    public async Task GuardarEdicion(int id)
    {
        await estudinateService.Editar(estudianteEdicion);
        Estudiantes = await estudinateService.GetList(L => true);

    }

}
